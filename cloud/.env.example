# Required for every environment. Generate a fresh 32-byte base64 value:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ORBIT_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Give this to yourself only when pairing a desktop. Rotate it after onboarding.
ORBIT_BOOTSTRAP_CODE=replace-with-a-long-one-time-pairing-code

# Keep this only on the server, never in the desktop application.
OPENAI_API_KEY=sk-proj-...

ORBIT_HOST=127.0.0.1
ORBIT_PORT=8787
ORBIT_DATABASE_PATH=./data/orbit-cloud.sqlite
ORBIT_MODEL=gpt-5.6
# In production, use HTTPS through a reverse proxy and list any browser origins here.
# ORBIT_ALLOWED_ORIGINS=https://app.example.com

# Required before enabling browser-based provider connections in production.
# The public URL must exactly match the OAuth redirect URLs registered with Google and Notion.
ORBIT_PUBLIC_URL=https://cloud.example.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# Used by cloud/deploy/compose.production.yml and Caddy for automatic HTTPS.
ORBIT_DOMAIN=cloud.example.com
