# Required for every environment. Generate a fresh 32-byte base64 value:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DIYA_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Give this to yourself only when pairing a desktop. Rotate it after onboarding.
DIYA_BOOTSTRAP_CODE=replace-with-a-long-one-time-pairing-code

# Keep this only on the server, never in the desktop application.
OPENAI_API_KEY=sk-proj-...

DIYA_HOST=127.0.0.1
DIYA_PORT=8787
# Local development can continue to use SQLite. Vercel production must use the
# Supabase transaction-pooler URL (Connect -> Transaction pooler), with
# `?sslmode=require` appended. Never commit the password-bearing URL.
DIYA_DATABASE_PATH=./data/diya-cloud.sqlite
# DIYA_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DIYA_MODEL=gpt-5.6
# Per-device UTC-calendar-month beta allowances. These protect your model budget.
DIYA_MONTHLY_SCREEN_GUIDE_LIMIT=250
DIYA_MONTHLY_APPROVED_ACTION_LIMIT=25
# Public early-access request throttle per IP address.
DIYA_WAITLIST_REQUEST_LIMIT=5
DIYA_WAITLIST_WINDOW_MS=900000
# In production, use HTTPS through a reverse proxy and list any browser origins here.
# DIYA_ALLOWED_ORIGINS=https://app.example.com

# Required before enabling browser-based provider connections in production.
# The public URL must exactly match the OAuth redirect URLs registered with Google and Notion.
DIYA_PUBLIC_URL=https://cloud.example.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# Used by cloud/deploy/compose.production.yml and Caddy for automatic HTTPS.
DIYA_DOMAIN=cloud.example.com
